#!/usr/bin/env bash
# Generated by the researchcloud-ddp-transcribe component — do not edit.
# Seed/refresh the interim volume from the Yoda collection (slow). Run once
# before the first batch, and again to pick up newly arrived donor DDPs.
# Afterwards hydrate the boot disk with ~/restore-from-storage.sh.
set -euo pipefail

YODA_COLLECTION="{{ yoda_collection }}" \
YODA_INBOX_LOCAL="{{ storage_path }}/inbox" \
  "{{ pipeline_home }}/yoda-sync.sh" pull-inbox

# Fresh volume (no snapshot yet): also pull prior campaign state +
# transcripts from Yoda so a rebuilt volume resumes instead of restarting.
if [ ! -f "{{ storage_path }}/state-snapshot.sqlite" ]; then
  YODA_COLLECTION="{{ yoda_collection }}" \
  YODA_STATE_SNAPSHOT="{{ storage_path }}/state-snapshot.sqlite" \
  YODA_TRANSCRIPTS_LOCAL="{{ storage_path }}/transcripts" \
    "{{ pipeline_home }}/yoda-sync.sh" pull-resume
fi
echo "volume seeded/refreshed from {{ yoda_collection }}"
