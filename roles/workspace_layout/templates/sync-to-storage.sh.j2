#!/usr/bin/env bash
# Generated by the researchcloud-ddp-transcribe component — do not edit.
# Pushes the boot-disk hot path to the durable storage backend (ADR 0032).
# Called automatically by run-pipeline*.sh at the end of a `process` run; also
# safe to run by hand (e.g. to checkpoint a long run during a pause).
{% if tiered_storage | bool %}
# Tiered mode (yoda + interim volume): this is hop 1 — fast rsync, boot disk
# -> volume, safe at every batch end. Hop 2 (volume -> Yoda, slow) is
# ~/push-to-yoda.sh, run by the operator (~daily).
{% endif %}
set -euo pipefail

# Serialize concurrent syncs: on a 2-GPU workspace both run-pipeline instances
# call this at the end of their `process` runs and would otherwise race on the
# shared state snapshot (concurrent sqlite .backup to one file corrupts it).
exec 9>"{{ state_dir }}/.sync.lock"
flock 9

{% if storage_backend == 'yoda' and not tiered_storage | bool %}
# Yoda (iRODS) sink via GoCommands. Snapshot the state DB locally first (a
# consistent online .backup, NOT a raw WAL copy), then push transcripts + the
# snapshot through the shared yoda-sync.sh.
sqlite3 "{{ state_dir }}/state.sqlite" ".backup '{{ state_dir }}/state-snapshot.sqlite'"
YODA_COLLECTION="{{ yoda_collection }}" \
YODA_TRANSCRIPTS_LOCAL="{{ work_dir }}/transcripts" \
YODA_STATE_SNAPSHOT="{{ state_dir }}/state-snapshot.sqlite" \
  "{{ pipeline_home }}/yoda-sync.sh" push
echo "synced (yoda): transcripts + state -> {{ yoda_collection }}"
{% else %}
# Mount-based sink (src-volume / mounted Research Drive).
# Consistent online snapshot of the state DB (NOT a raw copy of a live WAL),
# so a rebuilt workspace can resume via restore-from-storage.sh. Snapshot
# FIRST: the rsync must never gate snapshot freshness (a mid-run rsync
# hitting vanished in-flight files used to abort under set -e and silently
# leave a stale snapshot — the 2026-07-29..31 transcript-gap incident), and
# backup-before-artifacts guarantees the volume's artifacts are a superset
# of its snapshot's succeeded set, so the volume copy can be verified
# offline (`ddp-transcribe --state-db <snapshot> --transcripts
# <volume>/transcripts status --verify`).
sqlite3 "{{ state_dir }}/state.sqlite" ".backup '{{ storage_root }}/state-snapshot.sqlite'"

# Durable transcript sink: rsync the sharded NN/ tree boot disk -> volume.
# write-once atomic artifacts make this safe even if a run is still active.
# In-flight fetch transients are excluded (never sync-worthy; on pipeline
# >= v0.4.0 the .work/ tree self-cleans, making these cheap insurance), and
# exit 24 (files vanished mid-scan during active fetching — expected, the
# surviving files still synced) is tolerated.
rsync -a --exclude='.work' --exclude='*.tmp-*' \
  "{{ work_dir }}/transcripts/" "{{ storage_root }}/transcripts/" || [ $? -eq 24 ]

echo "synced: state -> {{ storage_root }}/state-snapshot.sqlite; transcripts -> {{ storage_root }}/transcripts"
{% endif %}
