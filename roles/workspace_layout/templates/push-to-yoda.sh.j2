#!/usr/bin/env bash
# Generated by the researchcloud-ddp-transcribe component — do not edit.
# Hop 2 of tiered storage: push the interim volume to the Yoda collection —
# shard tars + server-side extraction via the shared yoda-sync.sh. Slow
# (minutes at campaign scale); operator-driven (~daily / at milestones).
# Tunables (env): YODA_THREADS (default 10, keep <=15), YODA_EXTRACT,
# YODA_BUN_TIMEOUT — see yoda-sync.sh header.
set -euo pipefail

stable="{{ storage_path }}/.state-snapshot.hop2.sqlite"
trap 'rm -f "${stable}"' EXIT

# Take the sync lock ONLY to capture a stable copy of the state snapshot
# (hop 1 rewrites it at every batch end). The shard-tar build runs lock-free:
# transcript artifacts are write-once and tar staging excludes hidden entries
# (which also covers rsync in-flight temp files), so a concurrent hop 1
# cannot corrupt a tar — and a slow push never blocks a batch-end sync.
(
  exec 9>"{{ state_dir }}/.sync.lock"
  flock 9
  if [ -f "{{ storage_path }}/state-snapshot.sqlite" ]; then
    cp "{{ storage_path }}/state-snapshot.sqlite" "${stable}"
  fi
)

YODA_COLLECTION="{{ yoda_collection }}" \
YODA_TRANSCRIPTS_LOCAL="{{ storage_path }}/transcripts" \
YODA_STATE_SNAPSHOT="${stable}" \
  "{{ pipeline_home }}/yoda-sync.sh" push
echo "pushed (tiered hop 2): {{ storage_path }} -> {{ yoda_collection }}"
